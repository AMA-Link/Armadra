{
  "name": "@armadra/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./e2e": {
      "types": "./dist/e2e/index.d.ts",
      "import": "./dist/e2e/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo"
  },
  "dependencies": {
    "@armadra/platform-protocol": "file:../../tools/vendor/armadra-platform-protocol-0.21.0.tgz",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@orpc/contract": "1.16.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
