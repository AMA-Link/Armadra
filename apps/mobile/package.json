{
  "name": "@armadra/mobile",
  "description": "Armadra 的 Capacitor 手机壳：打包 apps/web 的产物，原生只补钥匙串、证书钉扎、扫码、推送与深链",
  "homepage": "https://github.com/AMA-Link/Armadra",
  "author": {
    "name": "YoVinchen",
    "email": "gzh298255@gmail.com"
  },
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web:prepare": "node scripts/prepare-web.mjs",
    "version:write": "node scripts/app-version.mjs write",
    "sync": "node scripts/app-version.mjs write && node scripts/prepare-web.mjs && cap sync",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
