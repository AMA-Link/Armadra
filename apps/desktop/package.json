{
  "name": "@armadra/desktop",
  "description": "Armadra desktop shell",
  "homepage": "https://github.com/AMA-Link/Armadra",
  "author": {
    "name": "YoVinchen",
    "email": "gzh298255@gmail.com"
  },
  "version": "0.16.0",
  "private": true,
  "main": "./out/main/entry.js",
  "desktopName": "armadra.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/launch-exe.mjs --if-windows && node scripts/winsec-exe.mjs --if-windows",
    "predev": "node scripts/ensure-electron.mjs",
    "dist": "node scripts/dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "pretest": "node scripts/ensure-node-pty.mjs",
    "test": "vitest run && vitest run --config vitest.live.config.mts && node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@armadra/platform-protocol": "file:../../tools/vendor/armadra-platform-protocol-0.16.0.tgz",
    "@armadra/shared": "workspace:*",
    "@orpc/openapi": "1.16.2",
    "@orpc/server": "1.16.2",
    "@sentry/electron": "7.20.2",
    "@simplewebauthn/server": "14.1.0",
    "acme-client": "5.4.0",
    "electron-updater": "6.8.11",
    "lib0": "0.2.119",
    "node-pty": "1.1.0",
    "nodemailer": "10.4.0",
    "otplib": "13.6.0",
    "ws": "8.22.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@armadra/agent": "0.16.0",
    "@electron/rebuild": "^4.2.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "js-yaml": "5.5.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "4.1.12"
  }
}
